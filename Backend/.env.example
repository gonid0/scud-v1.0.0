# Backend environment template. Скопировать → .env (dev) или .env.prod (prod).
# .env / .env.prod в .gitignore — НИКОГДА не коммитить.

# --- PostgreSQL ---
POSTGRES_USER=scud
POSTGRES_PASSWORD=change-me-strong
POSTGRES_DB=scud

# --- Connection URL ---
# Driver — asyncpg. В compose host = `postgres` (имя service внутри сети).
# В bare-metal деплое — реальный хост:порт.
DATABASE_URL=postgresql+asyncpg://scud:change-me-strong@postgres/scud

# --- API ---
# bind: 0.0.0.0 в dev, 127.0.0.1 в prod (за nginx-reverse-proxy).
API_BIND=127.0.0.1
API_PORT=8000

# --- Worker ---
WORKER_ID=worker-prod-1

# --- Sessions / auth ---
SESSION_LIFETIME_HOURS=24
REFRESH_LIFETIME_DAYS=30

# --- Bloom / filter generation ---
BLOOM_FP_RATE=0.001
WHITELIST_HARD_CAP=256
FILTER_GENERATION_DEBOUNCE_SECONDS=5
# Верхний потолок размера bloom (байт): per-reader фильтр всегда влезает в транспорт;
# выше потолка FP-rate растёт мягко (§3.4). Держать ниже firmware MAX_FILTER_BYTES.
FILTER_MAX_BLOOM_BYTES=100000
# Сколько раз пытаться подобрать serial, чтобы key_id не давал FP в текущем фильтре ридера.
ISSUE_KEY_BLOOM_RETRY_MAX=5

# --- Worker tuning ---
WORKER_POLL_INTERVAL_SECONDS=2

# --- Logging ---
LOG_LEVEL=info

# --- Admin web panel ---
# Подписывает cookie-сессии админ-панели (/admin/*). ОБЯЗАТЕЛЬНО менять в prod;
# при компрометации все активные admin web-сессии становятся forge-able.
# Рекомендация: 64+ символа urlsafe, ротировать раз в полгода.
SCUD_WEB_SECRET=dev-only-secret-CHANGE-IN-PROD
